--- !u!114 &522004315
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 522004314}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0183c47a27fd004d91a0beca100b2a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  nameInput: {fileID: 743701777}
  outputText: {fileID: 1199486515}
  outputText1: {fileID: 1970811617}
  outputText2: {fileID: 1970811617}
  nameCheck:
    namecheck:
    - Johnny
    - Jhemjon
    - Gay
    - Pare
    - Showwee
    - BeBoss
    - Roland
    - Shogun
    - Earth
    certian_text1:
    - "\u0E2B\u0E36\u0E49\u0E22\u0E22\u0E22\u0E22\u0E22 \u0E19\u0E35\u0E48\u0E21\u0E31\u0E19
      \u0E1B\u0E35\u0E28\u0E32\u0E08 KFC \u0E19\u0E35\u0E48\u0E2B\u0E27\u0E48\u0E32\u0E32\u0E32"
    - "\u0E27\u0E30\u0E2E\u0E30\u0E46\u0E46\u0E2E\u0E48\u0E32 \u0E40\u0E1A\u0E15\u0E49\u0E32\u0E40\u0E17\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E07\u0E31\u0E49\u0E19\u0E2B\u0E23\u0E2D"
    - "\u0E2D\u0E48\u0E32\u0E19\u0E44\u0E23\u0E44\u0E2D\u0E40\u0E01\u0E22\u0E4C"
    - "a.... \u0E2E\u0E30.... \u0E1E\u0E35\u0E48...\u0E1E\u0E35\u0E48\u0E01\u0E47\u0E2D\u0E22\u0E32\u0E01\u0E25\u0E2D\u0E07\u0E40\u0E25\u0E48\u0E19\u0E2B\u0E23\u0E2D...
      :3"
    - "Welcome back \u0E2D\u0E14\u0E35\u0E15 enigma"
    - "\u0E2D\u0E4B\u0E32\u0E32\u0E32 \u0E1A\u0E35\u0E1A\u0E32\u0E2A\u0E2B\u0E4C\u0E4C\u0E4C\u0E4C\u0E4C"
    - Exhausted? Tired. Want rest? Hungry. Want out?
    - "\u0E19\u0E35\u0E48\u0E44\u0E07 \u0E01\u0E39\u0E40\u0E08\u0E2D\u0E25\u0E30
      \u0E44\u0E2D\u0E04\u0E19\u0E40\u0E2A\u0E19\u0E2D\u0E44\u0E2D\u0E40\u0E14\u0E35\u0E22\u0E40\u0E01\u0E21\u0E19\u0E23\u0E01\u0E19\u0E35\u0E48"
    - "\u0E40\u0E2D\u0E34\u0E4A\u0E2A\u0E1A\u0E35 \u0E2B\u0E23\u0E37\u0E2D \u0E1A\u0E35\u0E40\u0E2D\u0E34\u0E4A\u0E2A\u0E01\u0E31\u0E19\u0E41\u0E19\u0E48\u0E48\u0E48\u0E48\u0E48\u0E48"
    certian_text2:
    - "\u0E1E\u0E35\u0E48\u0E44\u0E21\u0E48\u0E2B\u0E21\u0E34\u0E48\u0E19\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E44\u0E1B\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E2D\u0E4B\u0E2D"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E40\u0E2D\u0E32\u0E44\u0E27\u0E49\u0E40\u0E17\u0E2A\u0E27\u0E48\u0E32\u0E40\u0E01\u0E21\u0E40\u0E25\u0E48\u0E19\u0E44\u0E07"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E40\u0E01\u0E22\u0E4C\u0E40\u0E25\u0E48\u0E19\u0E40\u0E25\u0E22"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49.... \u0E1C\u0E21\u0E27\u0E48\u0E32\u0E40\u0E25\u0E48\u0E19\u0E07\u0E48\u0E32\u0E22\u0E14\u0E35\u0E19\u0E30\u0E1E\u0E35\u0E48
      :3"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E04\u0E27\u0E32\u0E21\u0E22\u0E32\u0E01\u0E23\u0E30\u0E14\u0E31\u0E1A
      enigma \u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19"
    - "\u0E07\u0E48\u0E32\u0E22\u0E44\u0E1B\u0E19\u0E30\u0E2B\u0E4C \u0E1A\u0E35\u0E1A\u0E32\u0E2A\u0E2B\u0E4C
      \u0E2D\u0E4B\u0E32\u0E32\u0E32\u0E32\u0E32"
    - Exhausted? Tired. Want rest? Hungry. Want out?
    - "\u0E44\u0E21\u0E48\u0E22\u0E32\u0E01\u0E46"
    - "\u0E40\u0E2B\u0E49\u0E22 \u0E40\u0E25\u0E48\u0E19\u0E07\u0E48\u0E32\u0E22\u0E41\u0E04\u0E48\u0E19\u0E19\u0E31\u0E49\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E42\u0E14\u0E19\u0E1A\u0E2D\u0E2A\u0E23\u0E38\u0E01\u0E42\u0E2B\u0E14\u0E2D\u0E4B\u0E2D"
    certian_text3:
    - "\u0E42\u0E2B\u0E21\u0E14\u0E19\u0E35\u0E49\u0E41\u0E2B\u0E25\u0E30\u0E1E\u0E35\u0E48
      \u0E2D\u0E31\u0E19\u0E41\u0E2B\u0E25\u0E30 \u0E1C\u0E21\u0E17\u0E33\u0E21\u0E32\u0E43\u0E2B\u0E49\u0E1E\u0E35\u0E48\u0E40\u0E25\u0E48\u0E19\u0E40\u0E25\u0E22"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E40\u0E2D\u0E32\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E1E\u0E35\u0E48\u0E08\u0E2D\u0E2B\u0E4C\u0E19\u0E19\u0E35\u0E48\u0E40\u0E25\u0E22\u0E22\u0E22\u0E22"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E42\u0E04\u0E15\u0E23\u0E40\u0E01\u0E22\u0E4C"
    - "\u0E2D\u0E37\u0E21.... \u0E1E\u0E35\u0E48\u0E41\u0E19\u0E48\u0E43\u0E08\u0E19\u0E30...
      \u0E2B\u0E19\u0E39\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E22\u0E32\u0E01\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E30"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E35\u0E49\u0E04\u0E27\u0E32\u0E21\u0E22\u0E32\u0E01\u0E23\u0E30\u0E14\u0E31\u0E1A
      MrX"
    - "\u0E2D\u0E31\u0E19\u0E19\u0E31\u0E49\u0E19\u0E23\u0E38\u0E19\u0E41\u0E23\u0E07\u0E21\u0E32\u0E01\u0E40\u0E25\u0E22\u0E19\u0E30\u0E1A\u0E35\u0E1A\u0E32\u0E2A\u0E2A\u0E2A\u0E2A"
    - Exhausted? Tired. Want rest? Hungry. Want out?
    - "\u0E44\u0E21\u0E48\u0E07\u0E48\u0E32\u0E22\u0E46 \u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E01\u0E39"
    - "\u0E40\u0E22\u0E14\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46\u0E46
      \u0E2D\u0E40\u0E2D\u0E34\u0E4A\u0E2A \u0E40\u0E2D\u0E32\u0E08\u0E23\u0E34\u0E07"
